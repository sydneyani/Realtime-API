# Copy this file to .env and fill in the values. Never commit .env.
#
# Create React App reads REACT_APP_* when the dev server or production build
# starts. Restart `npm start` after changing those variables.

# Required for `npm run relay`.
# Use an OpenAI user or project key that has access to the Realtime API.
# The relay reads this on the server. Do not put this value in frontend code.
OPENAI_API_KEY=

# Port for the relay WebSocket server. Defaults to 8081 when unset or invalid.
PORT=8081

# Leave this unset to paste an API key into the browser (stored in localStorage).
# Uncomment it to send browser traffic through the relay instead, so the API key
# stays in this file. The pinned Realtime client opens this value as a WebSocket
# URL, so use the ws:// scheme.
# REACT_APP_LOCAL_RELAY_SERVER_URL=ws://localhost:8081
